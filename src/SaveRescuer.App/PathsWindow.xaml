<Window x:Class="SaveRescuer.App.PathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paths" Height="380" Width="820" Background="#12160F"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#48FF9E" />
        <SolidColorBrush x:Key="InkDim" Color="#2FA96B" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E120C" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#2A352B" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="6,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2A1F" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkDim}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="12" Foreground="{StaticResource InkDim}"
                   TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Data folder: where the game keeps its plugins. Load order: the plugins.txt your setup actually uses (Mod Organizer 2 keeps one per profile). Saves folder: where your .fos files live." />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Data folder" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtData" Margin="0,0,8,8" />
        <Button Grid.Row="1" Grid.Column="2" Content="browse" Click="BrowseData_Click" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Load order" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtOrder" Margin="0,0,8,8" />
        <Button Grid.Row="2" Grid.Column="2" Content="browse" Click="BrowseOrder_Click" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Saves folder" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtSaves" Margin="0,0,8,8" />
        <Button Grid.Row="3" Grid.Column="2" Content="browse" Click="BrowseSaves_Click" Margin="0,0,0,8" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock Text="Detected load order files" Foreground="{StaticResource InkDim}" FontSize="11" />
            <ComboBox x:Name="CmbCandidates" Margin="0,4,0,0" SelectionChanged="CmbCandidates_SelectionChanged" />
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Re-detect" Click="Redetect_Click" Margin="0,0,8,0" />
            <Button Content="Save" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
