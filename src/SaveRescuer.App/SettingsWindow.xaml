<Window x:Class="SaveRescuer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="700" SizeToContent="Height" MinWidth="620"
        Background="{StaticResource Backdrop}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource H1}">Settings</TextBlock>
        <TextBlock Style="{StaticResource Label}" Margin="0,3,0,14">
            Folders are detected on first run; override them if your install lives elsewhere.
        </TextBlock>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionCaption}" Text="GAME DATA FOLDER" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DataBox" Grid.Column="0" FontFamily="{StaticResource Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="OnBrowseDataClick" Content="Browse…" />
                </Grid>
                <TextBlock Style="{StaticResource Label}" Margin="0,5,0,0"
                           Text="Decides which plugins still count as installed." />

                <TextBlock Style="{StaticResource SectionCaption}" Text="SAVE FOLDER" Margin="0,14,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SavesBox" Grid.Column="0" FontFamily="{StaticResource Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="OnBrowseSavesClick" Content="Browse…" />
                </Grid>

                <TextBlock Style="{StaticResource SectionCaption}" Text="BACKUP FOLDER" Margin="0,14,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VaultBox" Grid.Column="0" FontFamily="{StaticResource Mono}" FontSize="11.5" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="OnBrowseVaultClick" Content="Browse…" />
                </Grid>
                <TextBlock Style="{StaticResource Label}" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Keep this outside Documents\My Games: that folder is synced to the cloud and rotated by the game." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionCaption}" Text="RESCUE DEFAULTS" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="In-game name prefix" Margin="0,0,0,4" />
                        <TextBox x:Name="PrefixBox" />
                        <TextBlock Style="{StaticResource Label}" Text="First slot number" Margin="0,10,0,4" />
                        <TextBox x:Name="SlotBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox x:Name="VanillaBox" Content="Cut every mod out, not just the missing ones" />
                        <CheckBox x:Name="BackupBox" Margin="0,8,0,0" Content="Back up the original before each rescue" />
                        <CheckBox x:Name="ReplaceTagBox" Margin="0,8,0,0" Content="Replace an existing [tag] rather than stacking" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0">
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OnDetectClick"
                    Content="Detect folders again" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Click="OnCancelClick" Margin="0,0,8,0"
                        Padding="18,8" Content="Cancel" />
                <Button Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Padding="18,8" Content="Save" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
