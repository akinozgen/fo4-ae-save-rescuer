<Window x:Class="SaveRescuer.App.SavePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="My saves" Height="560" Width="960" Background="#12160F"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#48FF9E" />
        <SolidColorBrush x:Key="InkDim" Color="#2FA96B" />
        <SolidColorBrush x:Key="Amber" Color="#FFB642" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2A1F" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkDim}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171C14" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkDim}" />
            <Setter Property="RowBackground" Value="#171C14" />
            <Setter Property="AlternatingRowBackground" Value="#1B2118" />
            <Setter Property="HorizontalGridLinesBrush" Value="#22301F" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="prim:DataGridColumnHeader">
            <Setter Property="Background" Value="#1E2A1F" />
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Header" Text="Scanning saves..." Margin="0,0,0,10" FontSize="13" />

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" RowHeight="22" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150" />
                <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="50" />
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="180" />
                <DataGridTextColumn Header="Play time" Binding="{Binding PlayTime}" Width="140" />
                <DataGridTextColumn Header="Plugins" Binding="{Binding Plugins}" Width="90" />
                <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="90">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{Binding MissingBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="Hint" Text="double-click a row to open it" Foreground="{StaticResource InkDim}"
                       VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11" />
            <Button Content="Open selected" Click="BtnOk_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
