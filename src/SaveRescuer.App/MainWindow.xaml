<Window x:Class="SaveRescuer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fallout 4 Save Rescuer" Height="780" Width="1240" MinHeight="560" MinWidth="980"
        Background="{StaticResource Backdrop}" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop" WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}">Fallout 4 Save Rescuer</TextBlock>
                <TextBlock Style="{StaticResource Label}" Margin="0,3,0,0">
                    Cuts missing mod content out of a save so the game will load it again
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LaunchButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Click="OnLaunchClick" ToolTip="Start the game">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="LaunchIcon" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="Play" VerticalAlignment="Center" />
                        <TextBlock Text=" ▾" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnBackupsClick"
                        ToolTip="Saved copies of your originals">Backups</Button>
                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnSettingsClick"
                        ToolTip="Folders, prefix and rescue defaults">Settings</Button>
                <Button Style="{StaticResource GhostButton}" Click="OnRefreshClick"
                        ToolTip="Read the save folder again">Refresh</Button>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="392" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- filters -->
                    <Grid Grid.Row="0" Margin="12,12,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox" TextChanged="OnFilterChanged"
                                     ToolTip="Search by character, in-game name or file name" />
                            <TextBlock x:Name="SearchHint" Style="{StaticResource Label}" IsHitTestVisible="False"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="Search character, in-game name or file…" />
                        </Grid>
                        <ComboBox x:Name="CharacterFilter" Grid.Column="1" Width="150" Margin="8,0,0,0"
                                  SelectionChanged="OnFilterChanged" ToolTip="Character" />
                        <ComboBox x:Name="StatusFilter" Grid.Column="2" Width="160" Margin="8,0,0,0"
                                  SelectionChanged="OnFilterChanged" ToolTip="What the save needs" />
                    </Grid>

                    <DataGrid x:Name="SaveGrid" Grid.Row="1" Style="{StaticResource Grid}"
                              SelectionChanged="OnSaveSelected" MouseDoubleClick="OnGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="26" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                 ToolTip="{Binding StatusText}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="130" />
                            <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="46" />
                            <DataGridTextColumn Header="In-game name" Binding="{Binding InGameName}" Width="*" />
                            <DataGridTextColumn Header="Missing" Binding="{Binding MissingLabel}" Width="70" />
                            <DataGridTextColumn Header="Change forms" Binding="{Binding ChangeForms}" Width="105" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                            <DataGridTextColumn Header="Written" Binding="{Binding Written}" Width="130" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rescue…" Click="OnRescueClick" />
                                <MenuItem Header="Tag in-game name…" Click="OnRelabelClick" />
                                <MenuItem Header="Back up original" Click="OnBackupSelectedClick" />
                                <MenuItem Header="Show in folder" Click="OnShowInFolderClick" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,9">
                        <Grid>
                            <TextBlock x:Name="CountLabel" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource LinkButton}" Click="OnSelectNeedyClick"
                                        ToolTip="Select every save that is missing content">Select all that need rescue</Button>
                                <Button Style="{StaticResource LinkButton}" Click="OnOpenFolderClick">Open save folder</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource Label}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                               TextAlignment="Center">
                        Pick a save on the left,<LineBreak />or drop a .fos file onto this window.
                    </TextBlock>

                    <Grid x:Name="DetailContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0B0E13" CornerRadius="8,8,0,0" Height="158" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="Shot" Stretch="UniformToFill" />
                                <TextBlock x:Name="NoShot" Style="{StaticResource Label}" Text="no screenshot"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border VerticalAlignment="Bottom" Padding="12,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#000B0E13" Offset="0" />
                                            <GradientStop Color="#EE0B0E13" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock x:Name="DetailCharacter" Style="{StaticResource H2}" />
                                        <TextBlock x:Name="DetailName" Style="{StaticResource Label}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="14,12,14,0">
                            <Border Style="{StaticResource Card}" Padding="10,8" Background="#131922">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="OutlookDot" Width="8" Height="8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="OutlookTitle" Style="{StaticResource H2}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="OutlookNote" Style="{StaticResource Label}" TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock x:Name="ChipLevel" Style="{StaticResource Label}" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock x:Name="ChipPlayTime" Style="{StaticResource Label}" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock x:Name="ChipVersion" Style="{StaticResource Label}" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock x:Name="ChipSize" Style="{StaticResource Label}" />
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SectionCaption}" Text="CHANGE FORMS" />
                                    <TextBlock x:Name="StatChangeForms" Style="{StaticResource Value}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource SectionCaption}" Text="FORM IDS" />
                                    <TextBlock x:Name="StatFormIds" Style="{StaticResource Value}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="14,14,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="PluginCaption" Style="{StaticResource SectionCaption}" />
                                <CheckBox x:Name="MissingOnly" Content="missing only" HorizontalAlignment="Right"
                                          FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,-2,0,0"
                                          Checked="OnMissingOnlyChanged" Unchecked="OnMissingOnlyChanged" />
                            </Grid>
                            <Border Grid.Row="1" Background="#10151C" CornerRadius="6"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <ListBox x:Name="PluginList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,3" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,7,0"
                                                         VerticalAlignment="Center" Fill="{Binding StateBrush}"
                                                         ToolTip="{Binding StateText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Index}" FontSize="10.5"
                                                           FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource TextFaint}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5"
                                                           Foreground="{StaticResource Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="14">
                            <Button x:Name="RescueButton" Style="{StaticResource PrimaryButton}" Height="38"
                                    Click="OnRescueClick" Content="Rescue this save" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Click="OnBackupSelectedClick"
                                        Content="Back up" ToolTip="Keep a copy of the original outside the game folder" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="OnRelabelClick"
                                        Content="Tag name…" ToolTip="Change the name the load menu shows, nothing else" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Busy" Grid.Row="0" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
            <Grid Grid.Row="1">
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBlock x:Name="FolderLabel" Style="{StaticResource Label}" HorizontalAlignment="Right"
                           FontFamily="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </Grid>
        </Grid>
    </Grid>
</Window>
