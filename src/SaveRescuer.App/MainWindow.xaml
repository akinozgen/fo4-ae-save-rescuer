<Window x:Class="SaveRescuer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Fallout 4 AE Save Rescuer" Height="760" Width="1120"
        MinHeight="600" MinWidth="900"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#12160F">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#48FF9E" />
        <SolidColorBrush x:Key="InkDim" Color="#2FA96B" />
        <SolidColorBrush x:Key="Amber" Color="#FFB642" />
        <SolidColorBrush x:Key="Panel" Color="#171C14" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2A1F" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263A28" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#4A5A4C" />
                    <Setter Property="BorderBrush" Value="#2A352B" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkDim}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#22301F" />
            <Setter Property="RowBackground" Value="{StaticResource Panel}" />
            <Setter Property="AlternatingRowBackground" Value="#1B2118" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="prim:DataGridColumnHeader">
            <Setter Property="Background" Value="#1E2A1F" />
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="BorderBrush" Value="{StaticResource InkDim}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E120C" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#2A352B" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="FALLOUT 4 AE SAVE RESCUER" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Open saves that report missing content after the Anniversary / next-gen update"
                       Foreground="{StaticResource InkDim}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource InkDim}"
                BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="200" Height="120" BorderBrush="#2A352B" BorderThickness="1"
                        Background="#0E120C" Margin="0,0,14,0">
                    <Grid>
                        <TextBlock x:Name="ShotPlaceholder" Text="no preview" Foreground="#3E4A3F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                        <Image x:Name="ShotImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SaveTitle" Text="Drop a .fos save file here" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="SaveMeta" Text="or use the buttons on the right"
                               Foreground="{StaticResource InkDim}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock x:Name="SaveVerdict" Text="" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="BtnOpen" Content="Open save file..." Click="BtnOpen_Click" Margin="0,0,0,6" />
                    <Button x:Name="BtnBrowse" Content="Browse my saves" Click="BtnBrowse_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="PluginGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeRows="False" SelectionMode="Single" RowHeight="22">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46" />
                <DataGridTextColumn Header="Plugin" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="170">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{Binding StatusBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Data: " Foreground="{StaticResource InkDim}" FontSize="11" />
                    <TextBlock x:Name="PathData" Text="-" FontSize="11" MaxWidth="330" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="BtnPaths" Content="change paths" Click="BtnPaths_Click" Padding="8,1"
                            Margin="12,0,0,0" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Load order: " Foreground="{StaticResource InkDim}" FontSize="11" />
                    <TextBlock x:Name="PathOrder" Text="-" FontSize="11" MaxWidth="400" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnPreview" Content="Preview fix" Click="BtnPreview_Click" IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="BtnRescue" Content="Rescue this save" Click="BtnRescue_Click" IsEnabled="False"
                        Margin="0,0,8,0" FontWeight="Bold" />
                <Button x:Name="BtnRevert" Content="Undo last rescue" Click="BtnRevert_Click" />
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" AcceptsReturn="True" />
    </Grid>
</Window>
