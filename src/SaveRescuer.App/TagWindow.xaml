<Window x:Class="SaveRescuer.App.TagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag in-game name" Height="300" Width="520" SizeToContent="Height"
        Background="{StaticResource Backdrop}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource H1}">Tag the in-game name</TextBlock>
        <TextBlock Style="{StaticResource Label}" Margin="0,3,0,14" TextWrapping="Wrap">
            Writes a copy whose load-menu name carries a tag. The contents are left exactly as they
            are, which is handy for telling an untouched original apart from a rescued one.
        </TextBlock>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionCaption}" Text="PREFIX" />
                <TextBox x:Name="PrefixBox" TextChanged="OnPrefixChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource LinkButton}" Click="OnPresetClick" Tag="[OG] " Content="[OG]" />
                    <Button Style="{StaticResource LinkButton}" Click="OnPresetClick" Tag="[RESCUED] " Content="[RESCUED]" />
                    <Button Style="{StaticResource LinkButton}" Click="OnPresetClick" Tag="[KEEP] " Content="[KEEP]" />
                    <Button Style="{StaticResource LinkButton}" Click="OnPresetClick" Tag="[TEST] " Content="[TEST]" />
                </StackPanel>
                <TextBlock x:Name="Preview" Style="{StaticResource Label}" Margin="0,10,0,0"
                           FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}" Click="OnCancelClick" Margin="0,0,8,0"
                    Padding="18,8" Content="Cancel" />
            <Button Style="{StaticResource PrimaryButton}" Click="OnWriteClick" Padding="18,8"
                    Content="Write copy" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
