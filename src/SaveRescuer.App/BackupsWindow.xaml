<Window x:Class="SaveRescuer.App.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backups" Height="700" Width="1040" MinHeight="520" MinWidth="880"
        Background="{StaticResource Backdrop}" WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}">Backups</TextBlock>
                <TextBlock Style="{StaticResource Label}" Margin="0,3,0,0" TextWrapping="Wrap">
                    Copies of your original saves, kept outside the game's folder so neither the game
                    nor cloud sync can touch them.
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" Content="Open folder" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid x:Name="Grid" Style="{StaticResource Grid}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kept" Binding="{Binding When}" Width="152" />
                    <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="128" />
                    <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="54" />
                    <DataGridTextColumn Header="In-game name" Binding="{Binding InGameName}" Width="*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="94" />
                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="126" />
                    <DataGridTextColumn Header="Original file" Binding="{Binding OriginalName}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Click="OnPruneClick" Margin="0,0,8,0"
                        Content="Tidy list" ToolTip="Drop entries whose stored file is gone" />
                <Button Style="{StaticResource DangerButton}" Click="OnDeleteClick" Margin="0,0,8,0"
                        Content="Delete" ToolTip="Remove this copy from the backup folder" />
                <Button Style="{StaticResource GhostButton}" Click="OnRestoreElsewhereClick" Margin="0,0,8,0"
                        Content="Restore to…" />
                <Button Style="{StaticResource PrimaryButton}" Click="OnRestoreClick" Padding="18,8"
                        Content="Restore" ToolTip="Put this copy back where it came from" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
